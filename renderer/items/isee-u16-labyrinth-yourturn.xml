<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd"
  identifier="isee-u16-labyrinth-yourturn" title="Your Turn: Labyrinth" adaptive="true" time-dependent="false">

  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
    <qti-correct-response><qti-value>A</qti-value></qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
    <qti-default-value><qti-value>0</qti-value></qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="FEEDBACK" cardinality="single" base-type="identifier"/>
  <qti-outcome-declaration identifier="INTERACTION_VISIBILITY" cardinality="single" base-type="identifier">
    <qti-default-value><qti-value>show_interaction</qti-value></qti-default-value>
  </qti-outcome-declaration>

  <qti-item-body>
    <qti-feedback-block identifier="show_interaction" outcome-identifier="INTERACTION_VISIBILITY" show-hide="show" class="qti-margin-0">
      <qti-content-body>
        <qti-choice-interaction response-identifier="RESPONSE" shuffle="true" max-choices="1">
          <qti-prompt>Which sentence uses labyrinth correctly?</qti-prompt>
          <qti-simple-choice identifier="A">Beneath the theater lay a labyrinth of service corridors where even veteran stagehands sometimes lost their way.</qti-simple-choice>
          <qti-simple-choice identifier="B">Her essay outline was a labyrinth: three tidy points arranged in an order so clear that anyone could follow it at a glance.</qti-simple-choice>
          <qti-simple-choice identifier="C">The labyrinth in the town square was one open lawn where children flew kites without a hedge or wall in sight.</qti-simple-choice>
          <qti-simple-choice identifier="D">Locals loved the labyrinth behind the market: a single short alley that cut straight through to the station in under a minute.</qti-simple-choice>
        </qti-choice-interaction>
      </qti-content-body>
    </qti-feedback-block>

    <qti-feedback-block identifier="correct" outcome-identifier="FEEDBACK" show-hide="show">
      <qti-content-body><p>Right. Corridors so winding that even veteran stagehands lose their way form a confusing network of passages — precisely what a labyrinth is.</p></qti-content-body>
    </qti-feedback-block>
    <qti-feedback-block identifier="incorrect" outcome-identifier="FEEDBACK" show-hide="show">
      <qti-content-body><p>Not quite. A labyrinth is a winding network of passages that is easy to get lost in — a clear three-point outline, one open kite-flying lawn, and a single short alley cutting straight through are all simple to navigate. Find the true maze.</p></qti-content-body>
    </qti-feedback-block>
  </qti-item-body>

  <qti-response-processing>
    <qti-response-condition>
      <qti-response-if>
        <qti-match><qti-variable identifier="RESPONSE"/><qti-correct identifier="RESPONSE"/></qti-match>
        <qti-set-outcome-value identifier="SCORE"><qti-base-value base-type="float">1</qti-base-value></qti-set-outcome-value>
        <qti-set-outcome-value identifier="completionStatus"><qti-base-value base-type="identifier">completed</qti-base-value></qti-set-outcome-value>
        <qti-set-outcome-value identifier="FEEDBACK"><qti-base-value base-type="identifier">correct</qti-base-value></qti-set-outcome-value>
        <qti-set-outcome-value identifier="INTERACTION_VISIBILITY"><qti-base-value base-type="identifier">hidden</qti-base-value></qti-set-outcome-value>
      </qti-response-if>
      <qti-response-else>
        <qti-set-outcome-value identifier="SCORE"><qti-base-value base-type="float">0</qti-base-value></qti-set-outcome-value>
        <qti-set-outcome-value identifier="completionStatus"><qti-base-value base-type="identifier">incomplete</qti-base-value></qti-set-outcome-value>
        <qti-set-outcome-value identifier="FEEDBACK"><qti-base-value base-type="identifier">incorrect</qti-base-value></qti-set-outcome-value>
      </qti-response-else>
    </qti-response-condition>
  </qti-response-processing>
</qti-assessment-item>
